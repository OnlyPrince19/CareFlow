<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CareFlow.ViewModels"
             xmlns:models="using:CareFlow.Models"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700"
             x:Class="CareFlow.Views.NewBookingView"
             x:DataType="vm:NewBookingViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24">

            <!-- Title & Overview -->
            <Border Background="#F0F4F8" CornerRadius="8" Padding="16" BorderBrush="#D1D9E0" BorderThickness="1">
                <StackPanel Spacing="4">
                    <TextBlock Text="Create Diagnostic Booking" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text="Coordinate patient selection, date validation, service capacities, and atomic database transactions (BR-01 through BR-10)."
                               FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Feedback Message Banner -->
            <Border IsVisible="{Binding HasFeedback}"
                    CornerRadius="8" Padding="14" BorderThickness="1"
                    Classes.success="{Binding IsFeedbackSuccess}"
                    Classes.error="{Binding !IsFeedbackSuccess}">
                <Border.Styles>
                    <Style Selector="Border.success">
                        <Setter Property="Background" Value="#ECFDF5" />
                        <Setter Property="BorderBrush" Value="#A7F3D0" />
                    </Style>
                    <Style Selector="Border.error">
                        <Setter Property="Background" Value="#FEF2F2" />
                        <Setter Property="BorderBrush" Value="#FECACA" />
                    </Style>
                </Border.Styles>
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="●" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                               Classes.successIcon="{Binding IsFeedbackSuccess}"
                               Classes.errorIcon="{Binding !IsFeedbackSuccess}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.successIcon">
                                <Setter Property="Foreground" Value="#059669" />
                            </Style>
                            <Style Selector="TextBlock.errorIcon">
                                <Setter Property="Foreground" Value="#DC2626" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding FeedbackMessage}" TextWrapping="Wrap"
                               FontWeight="Medium" FontSize="13"
                               Classes.successText="{Binding IsFeedbackSuccess}"
                               Classes.errorText="{Binding !IsFeedbackSuccess}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock.successText">
                                <Setter Property="Foreground" Value="#065F46" />
                            </Style>
                            <Style Selector="TextBlock.errorText">
                                <Setter Property="Foreground" Value="#991B1B" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1*, 1.4*" RowDefinitions="Auto">
                <!-- Left Column: Patient & Date Selection -->
                <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,12,0">

                    <!-- Section: Patient Selection (BR-01) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="1. Patient Selection (BR-01)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                            <TextBlock Text="Choose an existing registered patient:" FontSize="12" Foreground="#64748B" />

                            <ComboBox ItemsSource="{Binding Patients}"
                                      SelectedItem="{Binding SelectedPatient}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Patient">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding PatientCode}" FontWeight="SemiBold" Foreground="#2563EB" />
                                            <TextBlock Text="-" Foreground="#94A3B8" />
                                            <TextBlock Text="{Binding FullName}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Gender, StringFormat='{}{0}'}" Foreground="#64748B" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Patient Info Summary Card -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10"
                                    IsVisible="{Binding SelectedPatient, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Patient Details:" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    <TextBlock Text="{Binding SelectedPatient.FullName, StringFormat='{}Name: {0}'}" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedPatient.DateOfBirth, StringFormat='{}DOB: {0:yyyy-MM-dd}'}" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SelectedPatient.ContactNumber, StringFormat='{}Phone: {0}'}" FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section: Booking Date (BR-03) -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="2. Booking Date (BR-03)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                            <TextBlock Text="Date cannot be earlier than current local date:" FontSize="12" Foreground="#64748B" />

                            <DatePicker SelectedDate="{Binding SelectedDate}" HorizontalAlignment="Stretch" />

                            <Button Content="Update Availability For Date"
                                    Command="{Binding LoadServicesForDateCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="10,6"
                                    FontSize="12" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Additional Notes -->
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="3. Optional Notes" FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                            <TextBox Text="{Binding Notes}" PlaceholderText="Clinical notes, fasting instructions, or remarks..."
                                     AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Section: AC-04 & AC-05 Verification Lab -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🧪 Verification Scenarios Sandbox" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" />
                            <TextBlock Text="Use these controls to verify acceptance criteria AC-04 &amp; AC-05 directly:"
                                       FontSize="11" Foreground="#3B82F6" TextWrapping="Wrap" />

                            <CheckBox IsChecked="{Binding SimulateFailureBeforeCommit}"
                                      Content="AC-05: Force failure before commit (Tests atomic rollback)"
                                      FontSize="12" Foreground="#1E3A8A" />

                            <Button Content="AC-04: Exhaust capacity in background (Stale UI test)"
                                    Command="{Binding SimulateStaleCapacityScenarioCommand}"
                                    HorizontalAlignment="Stretch"
                                    Background="#DBEAFE" Foreground="#1E40AF"
                                    FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Right Column: Diagnostic Services Selection (BR-02, BR-04, BR-05, BR-06) -->
                <StackPanel Grid.Column="1" Spacing="16" Margin="12,0,0,0">
                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="4. Diagnostic Services (BR-02, BR-04, BR-05, BR-06)"
                                               FontWeight="Bold" FontSize="14" Foreground="#0F172A" />
                                    <TextBlock Text="Select 1 to 3 distinct services. Capacity is calculated from persisted records."
                                               FontSize="12" Foreground="#64748B" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Command="{Binding LoadServicesForDateCommand}"
                                        Padding="8,4" FontSize="11" />
                            </Grid>

                            <!-- List of selectable services -->
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SelectableServiceItemViewModel">
                                        <Border Margin="0,4" Padding="12" CornerRadius="6"
                                                BorderThickness="1"
                                                Classes.selectedService="{Binding IsSelected}"
                                                Classes.unselectedService="{Binding !IsSelected}">
                                            <Border.Styles>
                                                <Style Selector="Border.selectedService">
                                                    <Setter Property="Background" Value="#F0FDF4" />
                                                    <Setter Property="BorderBrush" Value="#86EFAC" />
                                                </Style>
                                                <Style Selector="Border.unselectedService">
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,10,0"
                                                          VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="#1E293B" FontSize="13" />
                                                        <TextBlock Text="—" Foreground="#94A3B8" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="#334155" FontSize="13" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Department}" FontSize="11" Foreground="#64748B" />
                                                </StackPanel>

                                                <!-- Capacity Badge -->
                                                <Border Grid.Column="2" CornerRadius="12" Padding="8,4"
                                                        VerticalAlignment="Center"
                                                        Classes.availBadge="{Binding IsAvailable}"
                                                        Classes.fullBadge="{Binding !IsAvailable}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.availBadge">
                                                            <Setter Property="Background" Value="#DCFCE7" />
                                                            <Setter Property="BorderBrush" Value="#86EFAC" />
                                                        </Style>
                                                        <Style Selector="Border.fullBadge">
                                                            <Setter Property="Background" Value="#FEE2E2" />
                                                            <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                        </Style>
                                                    </Border.Styles>
                                                    <TextBlock Text="{Binding CapacityDisplay}" FontSize="11" FontWeight="SemiBold"
                                                               Classes.availText="{Binding IsAvailable}"
                                                               Classes.fullText="{Binding !IsAvailable}">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock.availText">
                                                                <Setter Property="Foreground" Value="#15803D" />
                                                            </Style>
                                                            <Style Selector="TextBlock.fullText">
                                                                <Setter Property="Foreground" Value="#B91C1C" />
                                                            </Style>
                                                        </TextBlock.Styles>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Submission buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                                <Button Content="Reset Selection" Command="{Binding ClearFormCommand}"
                                        Padding="14,8" />
                                <Button Content="Confirm Booking (Atomic Transaction)"
                                        Command="{Binding ConfirmBookingCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        FontWeight="SemiBold"
                                        Padding="18,8"
                                        Background="#2563EB" Foreground="#FFFFFF" />
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
