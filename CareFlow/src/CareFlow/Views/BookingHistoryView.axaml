<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CareFlow.ViewModels"
             xmlns:models="using:CareFlow.Models"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="700"
             x:Class="CareFlow.Views.BookingHistoryView"
             x:DataType="vm:BookingHistoryViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <Border Grid.Row="0" Background="#F0F4F8" CornerRadius="8" Padding="16" Margin="24,24,24,12" BorderBrush="#D1D9E0" BorderThickness="1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Confirmed Bookings History (Feature D, AC-06)" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B" />
                    <TextBlock Text="Review persisted bookings, patient information, and multi-service requests across sessions."
                               FontSize="13" Foreground="#64748B" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh List" Command="{Binding LoadBookingsCommand}"
                        Padding="14,8" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Master-Detail Layout -->
        <Grid Grid.Row="1" ColumnDefinitions="1.2*, 1.8*" Margin="24,0,24,24">

            <!-- Left: Bookings Master List -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#64748B" Margin="4,0,0,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Bookings}"
                             SelectedItem="{Binding SelectedBooking}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Booking">
                                <Border Padding="8" CornerRadius="6" Margin="0,2">
                                    <StackPanel Spacing="3">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding BookingReference}" FontWeight="Bold" Foreground="#2563EB" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{Binding BookingDate, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="12" Foreground="#64748B" />
                                        </Grid>
                                        <TextBlock Text="{Binding Patient.FullName}" FontWeight="Medium" FontSize="13" Foreground="#1E293B" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} diagnostic services'}" FontSize="11" Foreground="#475569" />
                                            <TextBlock Text="•" Foreground="#CBD5E1" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#059669" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Booking Detail View -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" IsVisible="{Binding SelectedBooking, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- Detail Header -->
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Booking Details" FontSize="16" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding SelectedBooking.BookingReference}" FontSize="18" FontWeight="Heavy" Foreground="#2563EB" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="CONFIRMED" FontWeight="Bold" FontSize="11" Foreground="#15803D" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Patient Details Section -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Patient Information" FontWeight="Bold" FontSize="13" Foreground="#334155" />
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Full Name: " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBooking.Patient.FullName}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient Code: " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBooking.Patient.PatientCode}" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Gender: " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedBooking.Patient.Gender}" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Contact: " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedBooking.Patient.ContactNumber}" FontSize="12" Margin="0,2,0,2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Schedule & Timestamps -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Schedule &amp; Audit Timestamps" FontWeight="Bold" FontSize="13" Foreground="#334155" />
                                <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Booking Date: " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedBooking.BookingDate, StringFormat='{}{0:dddd, MMMM dd, yyyy}'}" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,2" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Created At (UTC): " FontWeight="Medium" Foreground="#64748B" FontSize="12" Margin="0,2,8,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedBooking.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss UTC}'}" FontSize="12" Margin="0,2,0,2" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Included Services -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Included Diagnostic Services" FontWeight="Bold" FontSize="13" Foreground="#334155" />
                                <ItemsControl ItemsSource="{Binding SelectedBooking.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookingItem">
                                            <Border Margin="0,3" Padding="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0" Background="#EEF2FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DiagnosticService.Code}" FontWeight="Bold" Foreground="#4338CA" FontSize="11" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding DiagnosticService.Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" />
                                                        <TextBlock Text="{Binding DiagnosticService.Department}" FontSize="11" Foreground="#64748B" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="1 slot consumed" FontSize="11" Foreground="#059669" FontWeight="Medium" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Clinical Notes -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14"
                                IsVisible="{Binding SelectedBooking.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Clinical / Staff Notes" FontWeight="Bold" FontSize="13" Foreground="#334155" />
                                <TextBlock Text="{Binding SelectedBooking.Notes}" FontSize="12" TextWrapping="Wrap" Foreground="#475569" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>

</UserControl>
